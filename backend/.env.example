# =================================================================
# PATHPILOT AI - BACKEND ENVIRONMENT VARIABLES (.env)
# Smart India Hackathon Project
# =================================================================
# Instructions:
# 1. Copy this file and rename it to '.env' inside the 'backend' folder.
# 2. Fill in your keys below according to the beginner guide.
# =================================================================

# 1. SERVER CONFIGURATION
PROJECT_NAME="PathPilot AI Backend API"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# 2. GOOGLE GEMINI AI API KEY
# Obtain from: https://aistudio.google.com/
# Used by FastAPI to securely query Gemini 1.5 Flash without exposing keys to React.
GEMINI_API_KEY=your_gemini_api_key_here

# 3. JWT AUTHENTICATION SECRET
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# Used to securely sign authentication tokens for user sessions.
JWT_SECRET=your_32_character_hex_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. SUPABASE & POSTGRESQL DATABASE
# Obtain from your Supabase Dashboard -> Project Settings -> Database / API
# SUPABASE_URL: Project URL (e.g. https://xyz.supabase.co)
# SUPABASE_ANON_KEY: Public Anon Key
# SUPABASE_SERVICE_ROLE_KEY: Service Role Key (Backend Admin access)
# DATABASE_URL: PostgreSQL Connection String (postgresql://postgres:password@db.xyz.supabase.co:5432/postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# Obtain from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Used to allow real Google Sign-In on the website.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
